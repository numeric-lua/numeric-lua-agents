# Status and CLI


def status(config: dict, state_dir: Path) -> None:
    now = datetime.now(timezone.utc)
    active = window_at(config, now)
    print(f"now: {now.isoformat()}")
    print(f"window: {'none' if active is None else active[0].isoformat() + ' → ' + active[1].isoformat()}")
    print(f"lock: {config['lock']['path']}")
    print(f"state: {state_dir}")
    state = load_state(state_dir / "state.json")
    groups = list(state.get("running", {}).values())
    maintenance_state = state.get("maintenance", {})
    window_key = active[0].isoformat() if active else None

    if groups:
        for group in groups:
            current = group.get("current") or "none"
            print(f"running group: {group['id']} ({group['title']})")
            print(f"  branch: {group.get('branch')}")
            print(f"  current: {current}")
            print(f"  pending: {', '.join(group.get('pending', [])) or 'none'}")
            if group.get("failures"):
                print(f"  failures: {group['failures']}")
    else:
        print("running: none")

    max_tasks = int(config["schedule"].get("max_tasks_per_day", 0))
    if max_tasks:
        day = promo_day_key(now)
        tasks = state.get("tasks", {})
        count = int(tasks.get("count", 0)) if tasks.get("day") == day else 0
        print(f"tasks: {count}/{max_tasks} this promo day")

    for name in config["repos"]:
        task, errors = find_next_task(config, name)
        in_group = any(name in group.get("repos", []) for group in groups)
        if in_group:
            display = "running" if any(
                group.get("current") == name for group in groups
            ) else "pending"
        elif task:
            extra = ""
            if len(task["repos"]) > 1:
                extra = f" [repos: {', '.join(task['repos'])}]"
            display = f"queued ({task['path'].name}){extra}"
        elif errors:
            display = f"invalid task ({errors[0][0].name})"
        elif config["maintenance"].get("enabled", False):
            info = maintenance_state.get(name, {})
            if info.get("window") == window_key:
                display = f"maintenance ({int(info.get('rounds', 0))} this window)"
            else:
                display = "maintenance"
        else:
            display = "empty"
        print(f"{name}: {display}")


def print_config(config: dict) -> None:
    print(json.dumps(config, indent=2, sort_keys=True, default=str))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=config_default())
    parser.add_argument("--state-dir", type=Path, default=state_dir_default())
    parser.add_argument("--once", action="store_true",
                        help="run exactly one tick (the default)")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--status", action="store_true")
    parser.add_argument("--stop", action="store_true")
    parser.add_argument("--daemon", action="store_true")
    parser.add_argument("--print-config", action="store_true",
                        help="print the resolved configuration as JSON")
    parser.add_argument("--enqueue", metavar="REPO[,REPO...]",
                        help="queue a task for one or more repositories "
                             "(body from stdin or --body)")
    parser.add_argument("--title",
                        help="task title when the body has no heading")
    parser.add_argument("--body", help="task body; defaults to stdin")
    args = parser.parse_args()

    if args.daemon and args.once:
        parser.error("--daemon and --once are mutually exclusive")
    if (args.title or args.body) and not args.enqueue:
        parser.error("--title and --body are only used with --enqueue")
    if args.enqueue and (args.status or args.stop or args.once or args.daemon
                         or args.print_config):
        parser.error("--enqueue cannot be combined with --status/--stop/"
                     "--once/--daemon/--print-config")
    if args.daemon and args.dry_run:
        parser.error("--daemon and --dry-run are mutually exclusive")

    config_path = expand(args.config)
    state_dir = expand(args.state_dir)
    if not config_path.is_file():
        print(f"promo-agents: no config at {config_path}", file=sys.stderr)
        return 2

    config = load_config(config_path)
    events = state_dir / "agents.log"

    if args.enqueue:
        body = args.body or ""
        if not body and not sys.stdin.isatty():
            body = sys.stdin.read()
        return enqueue(config, args.enqueue, args.title, body, args.dry_run)

    if args.print_config:
        print_config(config)
        return 0
    if args.status:
        status(config, state_dir)
        return 0

    if args.dry_run:
        if args.stop:
            stop_and_finalize(config, state_dir, events, True)
        else:
            tick(config, state_dir, True, events)
        return 0

    lock_path = Path(config["lock"]["path"])
    lock = acquire_lock(lock_path)
    if lock is None:
        print("another scheduler tick is running", file=sys.stderr)
        return 0
    with lock:
        if args.stop:
            stop_and_finalize(config, state_dir, events, False)
            return 0
        if args.daemon:
            while True:
                tick(config, state_dir, False, events)
                time.sleep(30)
        tick(config, state_dir, False, events)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
