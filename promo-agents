# Planning and ticking


def plan_group(config: dict, repo_names: list[str], title: str, now: datetime,
               state_dir: Path) -> tuple[list[str], str, str, dict[str, str]]:
    eligible, failures = preflight(config, repo_names)
    if not eligible:
        return [], "", "", failures
    base, branch = choose_base(config, eligible, now, title, state_dir)
    return eligible, base, branch, failures


def print_plan(name: str, eligible: list[str], base: str, branch: str,
               failures: dict[str, str], state_dir: Path) -> None:
    for repo_name in eligible:
        worktree = worktree_path(state_dir, repo_name, base)
        print(f"would start {repo_name}: {branch} in {worktree}")
    for repo_name, reason in sorted(failures.items()):
        print(f"would skip {repo_name}: {reason}")


def report_task_errors(errors: list[tuple[Path, str]], events: Path,
                       dry: bool) -> None:
    for path, message in errors:
        if dry:
            print(f"warning: {message}")
        else:
            log(events, f"invalid task {path.name}: {message}")


def tick(config: dict, state_dir: Path, dry: bool, events: Path) -> None:
    now = datetime.now(timezone.utc)
    active = window_at(config, now)
    margin = timedelta(minutes=int(config["schedule"].get("stop_margin_minutes", 30)))

    if active is None:
        print("outside a discount window")
        stop_and_finalize(config, state_dir, events, dry)
        return

    start, end = active
    latest = end - margin
    print(f"window {start.isoformat()} → {end.isoformat()} "
          f"(stop by {latest.isoformat()})")
    if now >= latest:
        print("inside the stop margin; stopping agents")
        stop_and_finalize(config, state_dir, events, dry)
        return

    state = load_state(state_dir / "state.json")
    groups = list(state.get("running", {}).values())

    if groups:
        group = groups[0]
        name = group.get("current")
        if dry:
            if name and name in group.get("records", {}):
                pid = int(group["records"][name].get("pid", 0))
                if alive(pid):
                    print(f"would wait: {name} is still running")
                    return
                print(f"would finalize {name} and continue {group['branch']}")
            for pending in group.get("pending", []):
                print(f"would start {pending}: {group['branch']}")
            return

        if name and name in group.get("records", {}):
            record = group["records"][name]
            pid = int(record.get("pid", 0))
            current_boot = boot_id()
            on_other_boot = bool(record.get("boot") and current_boot
                                 and record["boot"] != current_boot)
            if on_other_boot:
                log(events, f"{group['id']}/{name}: agent is from an earlier "
                            f"boot; finalizing without signalling pid {pid}")
                finalize_repo(config, group, name, state_dir, events)
                save_running_group(state_dir, group)
            elif alive(pid):
                print(f"agent already running: {name}; one at a time")
                return
            else:
                log(events, f"{group['id']}/{name}: agent exited")
                finalize_repo(config, group, name, state_dir, events)
                save_running_group(state_dir, group)

        if group.get("pending"):
            after = datetime.now(timezone.utc)
            if after >= latest:
                print("inside the stop margin; not launching another repository")
                finalize_group(config, group, state_dir, events,
                               reason="stop margin reached before launch")
                return
            if launch_pending(config, group, state_dir, events, after):
                save_running_group(state_dir, group)
                print(f"started next repository: {group['current']}")
                return
            finalize_group(config, group, state_dir, events,
                           reason="agent failed to start")
            return

        finalize_group(config, group, state_dir, events)
        return

    max_tasks = int(config["schedule"].get("max_tasks_per_day", 0))
    if max_tasks:
        task_day = promo_day_key(now)
        task_info = state.setdefault("tasks", {})
        if task_info.get("day") != task_day:
            task_info.clear()
            task_info.update({"day": task_day, "count": 0})
        if int(task_info.get("count", 0)) >= max_tasks:
            print(f"daily task limit reached ({max_tasks})")
            return

    order = list(config["repos"])
    if not order:
        print("no repositories configured")
        return
    rotation = int(state.get("rotation", 0)) % len(order)
    maintenance_cfg = config["maintenance"]
    window_key = start.isoformat()

    for offset in range(len(order)):
        idx = (rotation + offset) % len(order)
        name = order[idx]
        repo = config["repos"][name]

        task, errors = find_next_task(config, name)
        report_task_errors(errors, events, dry)
        if task is not None:
            agent_ok, agent_reason = agent_available(config)
            if not agent_ok:
                if dry:
                    print(f"would skip {name}: {agent_reason}")
                else:
                    log(events, f"{name}: {agent_reason}; not launching")
                    print(f"{name}: {agent_reason}")
                continue

            eligible, base, branch, failures = plan_group(
                config, task["repos"], task["title"], now, state_dir,
            )
            if not eligible:
                if dry:
                    print(f"would skip {name}: no eligible repository")
                    for failed, reason in sorted(failures.items()):
                        print(f"  {failed}: {reason}")
                else:
                    log(events, f"{name}: task {task['path'].name} has no "
                                f"eligible repository: {failures}")
                    print(f"{name}: task cannot start: {failures}")
                continue

            if dry:
                print_plan(name, eligible, base, branch, failures, state_dir)
                print(f"  task: {task['path']}")
                return

            group = create_group(
                config, name, task, base, branch, eligible, failures,
                now, state_dir, events,
            )
            if not group["records"]:
                log(events, f"{name}: could not create any worktree for "
                            f"{task['path'].name}")
                continue
            if group["pending"]:
                launch_pending(config, group, state_dir, events, now)

            state = load_state(state_dir / "state.json")
            state.setdefault("running", {})[group["id"]] = group
            state["rotation"] = (idx + 1) % len(order)
            if max_tasks and group.get("current"):
                info = state.setdefault("tasks", {})
                day = promo_day_key(now)
                if info.get("day") != day:
                    info.clear()
                    info.update({"day": day, "count": 0})
                info["count"] = int(info.get("count", 0)) + 1
            save_state(state_dir / "state.json", state)
            log(events, f"{name}: task {task['path'].name} started as "
                        f"{group['branch']}")
            if group.get("current") is None:
                finalize_group(config, group, state_dir, events,
                               reason="agent failed to start")
            return

        if not maintenance_cfg.get("enabled", False):
            print(f"{name}: queue empty (maintenance disabled)")
            continue

        info = state.setdefault("maintenance", {}).setdefault(name, {})
        if info.get("window") != window_key:
            info.clear()
            info.update({"window": window_key, "rounds": 0, "last": 0.0})

        rounds = int(info.get("rounds", 0))
        max_rounds = int(maintenance_cfg.get("max_rounds_per_window", 0))
        if max_rounds and rounds >= max_rounds:
            print(f"{name}: maintenance limit reached ({max_rounds})")
            continue

        min_seconds = int(maintenance_cfg.get("min_round_seconds", 900))
        last = float(info.get("last", 0.0))
        if last and now.timestamp() - last < min_seconds:
            remaining = int(min_seconds - (now.timestamp() - last))
            print(f"{name}: next maintenance in {remaining}s")
            continue

        agent_ok, agent_reason = agent_available(config)
        if not agent_ok:
            if dry:
                print(f"would skip {name}: {agent_reason}")
            else:
                log(events, f"{name}: {agent_reason}; not launching maintenance")
                print(f"{name}: {agent_reason}")
            continue

        round_no = rounds + 1
        title = f"maintenance-{round_no}"
        eligible, base, branch, failures = plan_group(
            config, [name], title, now, state_dir,
        )
        if not eligible:
            if dry:
                print(f"would skip {name}: no eligible repository")
            else:
                log(events, f"{name}: maintenance is not launchable: {failures}")
            continue

        if dry:
            print_plan(name, eligible, base, branch, failures, state_dir)
            print(f"  maintenance round {round_no}")
            return

        task = {"path": None, "title": title, "body": "", "repos": [name]}
        group = create_group(
            config, name, task, base, branch, eligible, failures,
            now, state_dir, events, maintenance=True, round_no=round_no,
        )
        if not group["records"]:
            log(events, f"{name}: could not create the maintenance worktree")
            continue
        if group["pending"]:
            launch_pending(config, group, state_dir, events, now)

        state = load_state(state_dir / "state.json")
        state.setdefault("running", {})[group["id"]] = group
        info = state.setdefault("maintenance", {}).setdefault(name, {})
        if info.get("window") != window_key:
            info.clear()
            info.update({"window": window_key, "rounds": 0, "last": 0.0})
        info["last"] = now.timestamp()
        if group.get("current"):
            info["rounds"] = round_no
            if max_tasks:
                info_tasks = state.setdefault("tasks", {})
                day = promo_day_key(now)
                if info_tasks.get("day") != day:
                    info_tasks.clear()
                    info_tasks.update({"day": day, "count": 0})
                info_tasks["count"] = int(info_tasks.get("count", 0)) + 1
        state["rotation"] = (idx + 1) % len(order)
        save_state(state_dir / "state.json", state)
        log(events, f"{name}: maintenance round {round_no} started as "
                    f"{group['branch']}")
        if group.get("current") is None:
            finalize_group(config, group, state_dir, events,
                           reason="agent failed to start")
        return

    if dry:
        print("no repository is ready to launch")
    else:
        state = load_state(state_dir / "state.json")
        state["rotation"] = (rotation + 1) % len(order)
        save_state(state_dir / "state.json", state)
        print("no repository is ready to launch")


